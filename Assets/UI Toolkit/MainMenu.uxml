<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Styles/BaseStyles.uss?fileID=7433441132597879392&amp;guid=8bd749dfcb233ad489b00ff7b1606b19&amp;type=3#BaseStyles"/>
    <ui:VisualElement name="Background" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Asteroids%20Project%20Assets/Sprites/Menu/menu_background.png?fileID=2800000&amp;guid=f4031a255358c3342a3d0e6bab262e2f&amp;type=3#menu_background&quot;);">
        <ui:VisualElement name="MenuContainer" style="flex-grow: 1; justify-content: center;">
            <ui:VisualElement name="Logo" style="flex-grow: 1; background-image: url(&quot;project://database/Assets/Asteroids%20Project%20Assets/Sprites/Menu/Logo.png?fileID=2800000&amp;guid=111a3db01d7e0df4b810002f08f30055&amp;type=3#Logo&quot;); justify-content: center; align-items: center; align-self: center; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; width: 700px; height: 10px;"/>
            <ui:VisualElement name="BottomElement" style="flex-grow: 1;">
                <ui:VisualElement name="ButtonContainer" style="flex-grow: 1; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; justify-content: center; align-items: center; align-content: center; align-self: center; -unity-text-align: upper-center; width: 200px; height: 1px;">
                    <ui:VisualElement name="PlayButton" class="button menu-button" style="width: 300px;">
                        <ui:Label text="PLAY" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Audiowide-Regular.ttf?fileID=12800000&amp;guid=5baaaa4eb3bcff04d93cb1014e6af260&amp;type=3#Audiowide-Regular&quot;); font-size: 30px; -unity-text-align: upper-center; -unity-font-style: bold; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(190, 190, 190); text-shadow: 0 0 0 rgb(0, 0, 0); color: rgb(255, 255, 255); width: 100px; height: 40px; align-items: center; justify-content: center; align-self: center; align-content: center; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="QuitButton" class="button menu-button" style="width: 300px;">
                        <ui:Label text="QUIT&#10;" style="-unity-font-definition: url(&quot;project://database/Assets/Fonts/Audiowide-Regular.ttf?fileID=12800000&amp;guid=5baaaa4eb3bcff04d93cb1014e6af260&amp;type=3#Audiowide-Regular&quot;); font-size: 30px; -unity-text-align: upper-center; -unity-font-style: bold; -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(190, 190, 190); text-shadow: 0 0 0 rgb(0, 0, 0); color: rgb(255, 255, 255); width: 100px; height: 40px; align-items: center; justify-content: center; align-self: center; align-content: center; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0;"/>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="ShipLogo" style="flex-grow: 1; justify-content: center; width: 300px; height: 10px; background-image: url(&quot;project://database/Assets/Asteroids%20Project%20Assets/Sprites/Menu/ship_blur_flipped.png?fileID=2800000&amp;guid=cccab8d14d06df748a5e683a84a0044a&amp;type=3#ship_blur_flipped&quot;); align-content: flex-start; align-items: center; align-self: flex-start;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
