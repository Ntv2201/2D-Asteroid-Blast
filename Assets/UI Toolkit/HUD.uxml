<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Styles/BaseStyles.uss?fileID=7433441132597879392&amp;guid=8bd749dfcb233ad489b00ff7b1606b19&amp;type=3#BaseStyles"/>
    <ui:VisualElement name="Container" data-source-type="ScoreManager, Assembly-CSharp" class="container" style="padding-right: 25px; flex-grow: 1; aspect-ratio: auto;">
        <ui:VisualElement name="TopBar" class="top-bar" style="padding-top: 0; background-color: rgba(0, 0, 0, 0.235); width: 2130px; height: 135px;">
            <ui:Label text="Score:" name="ScoreLabel" class="score-label" style="height: 130px; color: rgb(255, 255, 255); font-size: 60px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Audiowide-Regular%20SDF.asset?fileID=11400000&amp;guid=f422c333f662e204f891d5636ab2c329&amp;type=2#Audiowide-Regular SDF&quot;); -unity-font-style: bold; -unity-text-align: middle-left; padding-left: 25px; padding-right: 5px; padding-top: 5px; padding-bottom: 5px; width: 250px;"/>
            <ui:Label text="000" name="ScoreValue" data-source-type="ScoreManager, Assembly-CSharp" class="score-value" style="-unity-font-style: bold; font-size: 60px; -unity-text-align: middle-center; white-space: normal; height: 130px; width: 300px;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="m_score" binding-mode="ToTarget"/>
                </Bindings>
            </ui:Label>
            <ui:VisualElement name="Spacer" style="flex-grow: 1;"/>
            <ui:VisualElement name="LivesIcon" class="lives-icon" style="flex-grow: 0; width: 100px; background-image: url(&quot;project://database/Assets/Asteroids%20Project%20Assets/Sprites/ship.png?fileID=21300000&amp;guid=01943d3552ba8bb468b153c2a292e784&amp;type=3#ship&quot;); -unity-background-scale-mode: scale-to-fit; margin-right: 5px; margin-top: 5px; -unity-text-align: lower-left; height: 150px;"/>
            <ui:Label text="3" name="LivesValue" data-source-type="ScoreManager, Assembly-CSharp" class="score-value" style="-unity-font-style: normal; font-size: 70px; -unity-text-align: middle-center; margin-right: 5px; width: 100px; height: 150px;">
                <Bindings>
                    <ui:DataBinding property="text" data-source-path="m_currentLives" binding-mode="ToTarget"/>
                </Bindings>
            </ui:Label>
        </ui:VisualElement>
        <ui:VisualElement name="GameOver" class="game-over-background" style="background-color: rgba(0, 0, 0, 0.588); color: rgb(0, 0, 0); justify-content: flex-start; align-content: flex-start; top: 1px; bottom: 0; right: 1px; left: 0;">
            <ui:VisualElement name="CenterPanel" class="game-over-center" style="background-color: rgba(0, 0, 0, 0); color: rgb(0, 0, 0); height: 1199px; width: 740px; justify-content: space-evenly; -unity-text-align: upper-center; background-size: 100% 100%; top: auto;">
                <ui:Label text="GAME OVER" name="GameOverLabel" class="game-over-label" style="color: rgb(255, 147, 0); background-color: rgba(0, 0, 0, 0); top: 100px; width: 580px; justify-content: center; height: 324px; font-size: 150px;">
                    <ui:VisualElement name="Spacer" style="flex-grow: 1;"/>
                    <ui:VisualElement name="TopScore" class="score-area" style="flex-grow: 1; opacity: 1; top: 50px; width: 562px;">
                        <ui:Label text="000" name="ScoreValue" class="score-value" style="color: rgb(255, 255, 255); -unity-text-outline-color: rgb(0, 158, 255); font-size: 40px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Audiowide-Regular.ttf?fileID=12800000&amp;guid=5baaaa4eb3bcff04d93cb1014e6af260&amp;type=3#Audiowide-Regular&quot;); -unity-text-align: middle-right; -unity-font-style: normal; -unity-text-outline-width: 1px; width: 350px; padding-left: 1px; white-space: nowrap; left: 200px; top: 50px; height: 45px;">
                            <Bindings>
                                <ui:DataBinding property="text" data-source-path="m_score" binding-mode="ToTarget"/>
                            </Bindings>
                        </ui:Label>
                        <ui:Label text="Your Score:" name="ScoreLabel" parse-escape-sequences="true" style="color: rgb(255, 255, 255); -unity-text-outline-color: rgb(0, 158, 255); font-size: 40px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Audiowide-Regular.ttf?fileID=12800000&amp;guid=5baaaa4eb3bcff04d93cb1014e6af260&amp;type=3#Audiowide-Regular&quot;); -unity-text-align: middle-center; -unity-font-style: normal; -unity-text-outline-width: 1px; width: 132px;"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="YourScore" enabled="true" class="score-area" style="flex-grow: 1; width: 567px;">
                        <ui:Label text="000" name="ScoreValue" class="score-value" style="color: rgb(255, 255, 255); -unity-text-outline-color: rgb(255, 185, 0); font-size: 40px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Audiowide-Regular.ttf?fileID=12800000&amp;guid=5baaaa4eb3bcff04d93cb1014e6af260&amp;type=3#Audiowide-Regular&quot;); -unity-text-align: middle-right; -unity-font-style: normal; -unity-text-outline-width: 1px; width: 350px; padding-left: 1px; white-space: nowrap; left: 200px; top: 50px; height: 45px;">
                            <Bindings>
                                <ui:DataBinding property="text" data-source-path="m_topScore" binding-mode="ToTarget"/>
                            </Bindings>
                        </ui:Label>
                        <ui:Label text="Top Score:" name="ScoreLabel" parse-escape-sequences="true" style="color: rgb(255, 255, 255); -unity-text-outline-color: rgb(0, 158, 255); font-size: 40px; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Audiowide-Regular.ttf?fileID=12800000&amp;guid=5baaaa4eb3bcff04d93cb1014e6af260&amp;type=3#Audiowide-Regular&quot;); -unity-text-align: middle-center; -unity-font-style: normal; -unity-text-outline-width: 1px; width: 132px;"/>
                    </ui:VisualElement>
                </ui:Label>
                <ui:VisualElement name="RetryButton" class="button" style="-unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Audiowide-Regular.ttf?fileID=12800000&amp;guid=5baaaa4eb3bcff04d93cb1014e6af260&amp;type=3#Audiowide-Regular&quot;); font-size: 14px; margin-top: 5px; flex-direction: column; margin-right: 5px; margin-bottom: 5px; margin-left: 5px; white-space: normal; opacity: 1; top: 200px; width: 200px; height: 70px;">
                    <ui:Label text="RETRY" name="ButtonLabel" class="button-label"/>
                </ui:VisualElement>
                <ui:VisualElement name="QuitButton" class="button" style="-unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/Fonts/Audiowide-Regular.ttf?fileID=12800000&amp;guid=5baaaa4eb3bcff04d93cb1014e6af260&amp;type=3#Audiowide-Regular&quot;); font-size: 14px; top: 30px; width: 200px; height: 70px;">
                    <ui:Label text="EXIT GAME" name="ButtonLabel" class="button-label"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
