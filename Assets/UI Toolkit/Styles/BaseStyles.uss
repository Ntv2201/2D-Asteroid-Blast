:root {
}

.hidden {
    display: none;
    transition-timing-function: ease;
    transition-duration: 0s;
}

.container {
}

.top-bar {
    flex-grow: 0;
    height: 50px;
    background-color: rgba(0, 0, 0, 0.157);
    flex-direction: row;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 25px;
}

.score-value {
    height: 44px;
    color: rgb(255, 255, 255);
    font-size: 30px;
    -unity-font-definition: url("project://database/Assets/Fonts/Audiowide-Regular%20SDF.asset?fileID=11400000&guid=f422c333f662e204f891d5636ab2c329&type=2#Audiowide-Regular SDF");
    -unity-font-style: normal;
    -unity-text-align: upper-center;
    white-space: nowrap;
}

.game-over-background {
    flex-grow: 1;
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    align-items: center;
    justify-content: center;
    transition-timing-function: ease-out-circ;
    transition-duration: 0.3s;
}

.game-over-label {
    color: rgb(205, 118, 0);
    -unity-font-style: bold;
    -unity-font-definition: url("project://database/Assets/Fonts/Iceland-Regular.ttf?fileID=12800000&guid=42ceeaacebab2c14992d25a7552f49ff&type=3#Iceland-Regular");
    font-size: 60px;
    -unity-text-align: upper-center;
    -unity-text-outline-color: rgb(153, 80, 0);
    -unity-text-outline-width: 2px;
}

.game-over-center {
    flex-grow: 0;
    width: 300px;
    height: 350px;
    background-color: rgb(0, 0, 0);
    color: rgb(0, 0, 0);
    align-items: center;
}

.button {
    flex-grow: 0;
    background-color: rgb(0, 143, 255);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-left-color: rgb(0, 67, 120);
    border-right-color: rgb(0, 67, 120);
    border-top-color: rgb(0, 67, 120);
    border-bottom-color: rgb(0, 67, 120);
    align-items: stretch;
    width: 230px;
    height: 45px;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    transition-property: scale;
    transition-duration: 0.2s;
}

.button-label {
    -unity-font-style: bold;
    flex-grow: 1;
    font-size: 22px;
    color: rgb(255, 255, 255);
}

.button:hover {
    border-left-color: rgb(0, 243, 255);
    border-right-color: rgb(0, 243, 255);
    border-top-color: rgb(0, 243, 255);
    border-bottom-color: rgb(0, 243, 255);
    scale: 1.1 1.1 1.1;
}

.button:hover .button-label {
    border-left-color: rgb(0, 219, 255);
    border-right-color: rgb(0, 219, 255);
    border-top-color: rgb(0, 219, 255);
    border-bottom-color: rgb(0, 219, 255);
    color: rgb(183, 202, 217);
}

.button:active {
    border-left-color: rgb(200, 252, 255);
    border-right-color: rgb(200, 252, 255);
    border-top-color: rgb(200, 252, 255);
    border-bottom-color: rgb(200, 252, 255);
    scale: 1.1 1.1 1.1;
}

.button {
    flex-grow: 0;
    font-size: 0;
    background-size: 100% 70%;
    width: 150px;
    height: 50px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    -unity-text-align: middle-center;
    white-space: normal;
    text-overflow: clip;
    justify-content: flex-end;
    align-items: center;
    align-self: center;
    align-content: center;
    flex-direction: column;
    flex-wrap: nowrap;
    color: rgb(16, 174, 249);
    -unity-text-outline-width: 1px;
    background-image: none;
    background-color: rgb(0, 171, 255);
    border-left-color: rgb(0, 108, 255);
    border-right-color: rgb(0, 108, 255);
    border-top-color: rgb(0, 108, 255);
    border-bottom-color: rgb(0, 108, 255);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    bottom: 10px;
}

.button {
    flex-grow: 0;
    font-size: 0;
    background-size: 100% 70%;
    width: 150px;
    height: 50px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    -unity-text-align: middle-center;
    white-space: normal;
    text-overflow: clip;
    justify-content: flex-end;
    align-items: center;
    align-self: center;
    align-content: center;
    flex-direction: column;
    flex-wrap: nowrap;
    color: rgb(16, 174, 249);
    -unity-text-outline-width: 1px;
    background-image: none;
    background-color: rgb(0, 171, 255);
    border-left-color: rgb(0, 108, 255);
    border-right-color: rgb(0, 108, 255);
    border-top-color: rgb(0, 108, 255);
    border-bottom-color: rgb(0, 108, 255);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    bottom: 0;
}

.menu-button {
    margin-bottom: 10px;
}

.menu-button {
}
